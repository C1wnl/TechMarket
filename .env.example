# Copia este archivo como .env y cambia los valores de ejemplo.
DB_PASSWORD=techmarket_local
JWT_SECRET=ChangeThisToAUniqueSecretAtLeastThirtyTwoCharactersLong
USER_INTERNAL_KEY=ChangeThisUserInternalKey_2026
PAYMENT_INTERNAL_KEY=ChangeThisPaymentInternalKey_2026
STOCK_INTERNAL_KEY=ChangeThisStockInternalKey_2026

# Opcional: deja vacío si todavía no configuras Cloudinary.
CLOUDINARY_URL=
